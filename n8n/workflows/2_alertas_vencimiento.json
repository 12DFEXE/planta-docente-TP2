      ],
      "parameters": {
        "url": "http://api:8000/alertas/vencimientos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "dias",
              "value": "30"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "13034319-53ff-45ed-8acd-9459f3708a12",
      "name": "¿Hay designaciones por vencer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "91913d77-6f03-4690-8364-ab1907c66b17",
              "leftValue": "={{ $json.cantidad }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c2d87ea2-eca1-4950-bd64-40e7e57ffa42",
      "name": "Avisar vencimientos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notificaciones",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ origen: \"n8n: vencimientos\", nivel: ($json.alertas.some(a => a.estado === 'vencida') ? 'urgente' : 'alerta'), titulo: $json.cantidad + ' designación(es) vencida(s) o por vencer en ' + $json.dias + ' días', mensaje: $json.alertas.map(a => '• ' + a.docente_nombre + ' – ' + a.materia_nombre + ': vence el ' + a.fecha_vencimiento + (a.dias_restantes < 0 ? ' (VENCIDA hace ' + (-a.dias_restantes) + ' días)' : ' (faltan ' + a.dias_restantes + ' días)')).join('\\n') + '\\n\\nHay que renovarlas o reasignar las materias.' }) }}",
        "options": {}
      }
    },
    {
      "id": "48c6db6c-97c6-44dc-90e1-bf68f654d59a",
      "name": "Sin novedades",
