      "id": "04c7c4b1-5e16-44b2-87f4-c8ef96479c62",
      "name": "Consultar vencimientos (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
