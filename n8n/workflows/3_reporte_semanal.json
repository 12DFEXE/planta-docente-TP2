        480
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/notificaciones",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ origen: \"n8n: reporte semanal\", nivel: 'alerta', titulo: 'No se pudo generar el reporte semanal', mensaje: (() => { const e = $json.error; const m = typeof e === 'object' ? (e.message || JSON.stringify(e)) : String(e || 'error desconocido'); try { const d = JSON.parse(JSON.parse(m.slice(m.indexOf(' - ') + 3))); return d.detail || m; } catch (x) { return m; } })() }) }}",
        "options": {}
      }
    }
