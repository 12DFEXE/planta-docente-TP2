# Copiar este archivo como .env (el .env NO se sube a Git)
DB_PATH=/app/data/planta_docente.db

# IA local con Ollama (corre en la computadora, fuera de Docker)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
# Segundos máximos de espera por respuesta de la IA
OLLAMA_TIMEOUT=180
